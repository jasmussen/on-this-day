{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "On This Day prototype (opt-in)",
		"author": "jasmussen",
		"description": "The opt-in variant: nothing is shown until the question is answered."
	},
	"landingPage": "/wp-admin/index.php?otd_mode=opt-in",
	"preferredVersions": {
		"php": "8.3"
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/jasmussen/on-this-day",
				"ref": "main",
				"path": "/"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; foreach ( glob( '/wordpress/wp-content/plugins/*/tools/seed.php' ) as $seed ) { require $seed; }"
		}
	]
}

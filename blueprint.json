{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "On This Day prototype",
		"author": "jasmussen",
		"description": "A dedicated On This Day dashboard widget, seeded with posts to look at."
	},
	"landingPage": "/wp-admin/index.php",
	"preferredVersions": {
		"php": "8.3"
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/jasmussen/on-this-day",
				"ref": "main",
				"path": "/"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; foreach ( glob( '/wordpress/wp-content/plugins/*/tools/seed.php' ) as $seed ) { require $seed; }"
		}
	]
}
